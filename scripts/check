#!/bin/sh
# Runs what CI runs; prints one line per step and exits nonzero if any step failed.
status=0
export PUBLIC_SITE_URL="${PUBLIC_SITE_URL:-https://example.com}" PUBLIC_BUSINESS_NAME="${PUBLIC_BUSINESS_NAME:-Example}"
for step in lint format:check check build; do
  if out=$(npm run --silent "$step" 2>&1); then
    echo "ok   $step"
  else
    echo "FAIL $step"
    echo "$out"
    status=1
  fi
done
exit $status
